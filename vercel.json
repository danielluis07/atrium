{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "builder": {
      "root": "scripts/houses/builder",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
